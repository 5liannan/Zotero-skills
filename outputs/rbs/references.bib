@article{Nelkin_1966_brillouin_scattering_by,
  author = {Nelkin, Mark and Yip, Sidney},
  title = {Brillouin Scattering by Gases as a Test of the Boltzmann Equation},
  journal = {The Physics of Fluids},
  year = {1966},
  volume = {9},
  number = {2},
  pages = {380--381},
  doi = {10.1063/1.1761682},
  publisher = {AIP Publishing},
  abstract = {The frequency distribution of monochromatic light scattered by a gas is proposed as an experimental test of kinetic theory away from the hydrodynamic regime. The phenomenon is closely analogous to high-frequency sound propagation and is governed by the same linearized Boltzmann equation. The problem can be posed as an initial value problem in an infinite medium. The exact numerical solutions for Maxwell molecules of the preceding paper give an estimate of the results to be expected.},
}

@article{Yip_1971_rayleigh_scattering_in,
  author = {Yip, Sidney},
  title = {Rayleigh Scattering in Dilute Gases},
  journal = {The Journal of the Acoustical Society of America},
  year = {1971},
  volume = {49},
  number = {3C},
  pages = {941--949},
  doi = {10.1121/1.1912453},
  publisher = {Acoustical Society of America (ASA)},
  abstract = {Large-angle Rayleigh scattering of light provides a tool for studying fluctuations in dilute gases where the wavelength is comparable to the mean free path. Interpretation of such an experiment requires a molecular calculation of the spectrum of the density fluctuation. The initial value problem can be formulated using the linearized Boltzmann equation. Solutions are obtained for two types of repulsive intermolecular potential, Maxwell molecule and rigid sphere, and the results are used in a quantitative analysis of high-resolution measurement. The problem of studying molecular gases in a similar way is also discussed.},
}

