@article{vanderElsken_1989_rayleigh_brillouin_light,
  author = {van der Elsken, J. and Bot, Arjen},
  title = {Rayleigh–Brillouin light scattering from multicomponent mixtures: The Landau–Placzek ratio},
  journal = {Journal of Applied Physics},
  year = {1989},
  volume = {66},
  number = {5},
  pages = {2118--2121},
  doi = {10.1063/1.344306},
  publisher = {AIP Publishing},
  abstract = {In one-component fluids Rayleigh–Brillouin light scattering can be used to determine the equation of state of the fluid: A combination of the Brillouin shift and the Landau–Placzek ratio yields the isothermal compressibility. The same technique has been applied to multicomponent mixtures. We derive an expression for the Landau–Placzek ratio in a multicomponent mixture and show that it contains additional terms compared to the one-component case due to concentration fluctuations in the mixture. When we apply the expression to recent experiments on a five-component mixture of hydrocarbons, we show that the additional contribution cannot be neglected.},
}

